{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:creeper",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "minecraft:exploding": {
        "minecraft:explode": {
          "fuse_length": 1.5,
          "fuse_lit": true,
          "power": 3,
          "causes_fire": false,
          "break_blocks": true,
          "fire_affected_by_griefing": true,
          "destroy_affected_by_griefing": true
        }
      },
      "minecraft:ignited": {
        "minecraft:ignite": {}
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["creeper", "monster"] },
      "minecraft:health": { "value": 20, "max": 20 },
      "minecraft:collision_box": { "width": 0.6, "height": 1.8 },
      "minecraft:movement": { "value": 0.25 },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "can_pass_doors": true
      },
      "minecraft:can_climb": {},
      "minecraft:follow_range": { "value": 16 },
      "minecraft:leashable": { "soft_distance": 4, "hard_distance": 6, "max_distance": 10 },
      "minecraft:attack": { "damage": 0 },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:explode": {
        "fuse_length": 1.5,
        "fuse_lit": false,
        "power": 3,
        "causes_fire": false,
        "break_blocks": true,
        "fire_affected_by_griefing": true,
        "destroy_affected_by_griefing": true
      },
      "minecraft:behavior.float": { "priority": 0 },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 2,
        "entity_types": [
          { "filters": { "test": "is_family", "subject": "other", "value": "gato" }, "max_dist": 10, "walk_speed_multiplier": 1.2, "sprint_speed_multiplier": 1.2 },
          { "filters": { "test": "is_family", "subject": "other", "value": "feline" }, "max_dist": 10, "walk_speed_multiplier": 1.2, "sprint_speed_multiplier": 1.2 }
        ],
        "avoid_mob_speed": 1.25
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 3,
        "entity_types": [
          { "filters": { "test": "is_family", "subject": "other", "value": "player" }, "max_dist": 16 }
        ],
        "must_see": true
      },
      "minecraft:behavior.swell": { "priority": 4 },
      "minecraft:behavior.flee_sun": { "priority": 5 },
      "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 1.0 },
      "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 6, "probability": 0.02 },
      "minecraft:behavior.random_look_around": { "priority": 8 },
      "minecraft:behavior.hurt_by_target": { "priority": 1 }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["minecraft:exploding"] }
      },
      "minecraft:start_exploding": {
        "add": { "component_groups": ["minecraft:ignited"] }
      }
    }
  }
}
